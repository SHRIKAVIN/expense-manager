# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (VAPID) — run: npm run vapid:generate
# Public key only in the client; private key goes in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=

# Vercel keep-alive API (server-side — set in Vercel → Environment Variables)
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# TEAMS_WEBHOOK_URL=your_teams_incoming_webhook_url
# KEEP_ALIVE_TABLE=profiles
